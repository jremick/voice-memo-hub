<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.voice-memo-hub</string>

  <key>ProgramArguments</key>
  <array>
    <string>__VOICE_MEMO_HUB_BIN__</string>
    <string>run-once</string>
    <string>--transcribe</string>
    <string>--limit</string>
    <string>2</string>
    <string>--max-duration-seconds</string>
    <string>1800</string>
    <string>--apply-policy</string>
  </array>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>StandardOutPath</key>
  <string>__VOICE_MEMO_HUB_LOG_DIR__/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>__VOICE_MEMO_HUB_LOG_DIR__/launchd.err.log</string>
</dict>
</plist>
